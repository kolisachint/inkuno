[Desktop Entry]
Type=Application
Name=Inkuno
GenericName=Notes
GenericName[fr]=Notes
Comment=Fast, minimal Markdown notes
Comment[fr]=Prise de notes Markdown, rapide et minimaliste
Exec=inkuno
Icon=com.inkuno.Inkuno
Terminal=false
Categories=Office;TextEditor;
Keywords=notes;markdown;writing;
Keywords[fr]=notes;markdown;écriture;
StartupNotify=true
StartupWMClass=com.inkuno.Inkuno
Actions=Capture;

[Desktop Action Capture]
Name=Quick capture
Name[fr]=Capture rapide
Exec=inkuno --capture
